rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'silver', 'inventory', 'updatedAt']) 
          && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
          && data.uid == request.auth.uid
          && data.silver is number
          && data.inventory is map
          && (data.keys().hasAll(['premium']) ? data.premium is bool : true)
          && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid 
                    && isValidUserProfile(incoming())
                    && incoming().keys().size() <= 5;
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid
                    && isValidUserProfile(incoming())
                    && incoming().uid == existing().uid
                    && incoming().diff(existing()).affectedKeys().hasOnly(['silver', 'inventory', 'premium', 'updatedAt']);
    }

    // Validation for Report
    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'title', 'content', 'createdAt'])
          && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
          && data.userId == request.auth.uid
          && data.title is string && data.title.size() <= 200
          && data.content is string && data.content.size() <= 500000
          && data.createdAt == request.time;
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(reportId) 
                    && isValidReport(incoming())
                    && incoming().keys().size() == 4;
      allow delete: if isSignedIn() && isValidId(reportId) && existing().userId == request.auth.uid;
    }
    // Validation for BestFlip
    function isValidBestFlip(data) {
      return data.keys().hasAll(['userId', 'displayName', 'itemId', 'itemName', 'profit', 'roi', 'sourceCity', 'createdAt'])
          && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
          && data.userId == request.auth.uid
          && data.displayName is string && data.displayName.size() <= 100
          && data.itemId is string && data.itemId.size() <= 100
          && data.itemName is string && data.itemName.size() <= 200
          && data.profit is number
          && data.roi is number
          && data.sourceCity is string && data.sourceCity.size() <= 50
          && data.createdAt == request.time;
    }

    match /bestFlips/{flipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(flipId) 
                    && isValidBestFlip(incoming())
                    && incoming().keys().size() == 8;
    }
  }
}
